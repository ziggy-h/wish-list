{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ziggy-h/wish-list/schemas/wishlist.schema.json",
  "title": "Wishlist",
  "description": "Schema for wishlist.yaml in ziggy-h/wish-list.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "currency", "price_tiers", "categories"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Top-level document heading rendered in README.md."
    },
    "currency": {
      "type": "string",
      "enum": ["USD"],
      "description": "ISO 4217 currency code for item prices."
    },
    "price_tiers": {
      "type": "array",
      "minItems": 1,
      "description": "Price tiers ordered strictly descending by min price; the lowest tier must have min: 0.",
      "items": {
        "$ref": "#/$defs/priceTier"
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered list of wishlist categories.",
      "items": {
        "$ref": "#/$defs/category"
      }
    }
  },
  "$defs": {
    "priceTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "min"],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Heading text displayed for this price tier (e.g. \"$100+\", \"Under $5\")."
        },
        "min": {
          "type": "number",
          "minimum": 0,
          "description": "Inclusive lower bound in currency units for items assigned to this tier."
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "items"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Unique lowercase kebab-case category identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable category heading."
        },
        "items": {
          "type": "array",
          "description": "Items belonging to this category.",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "colorEntry": {
      "description": "A color/variant specified either as a plain string or an object supporting per-color purchased state.",
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "purchased": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "image", "price", "retrieved", "retailer"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "description": "Globally unique lowercase kebab-case item identifier."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Display title for the item."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "description": "Canonical manufacturer or product URL."
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["alt", "url"],
          "properties": {
            "alt": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          }
        },
        "price": {
          "type": "number",
          "minimum": 0,
          "description": "Lowest verified unit price."
        },
        "retrieved": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO 8601 date (YYYY-MM-DD) when the price was last verified."
        },
        "retailer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          }
        },
        "colors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/colorEntry"
          }
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "power": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "option": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        },
        "purchased": {
          "type": "boolean",
          "description": "When true, the item is hidden from README.md while retained in wishlist.yaml."
        },
        "purchased_date": {
          "type": "string",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Optional ISO 8601 date (YYYY-MM-DD) when the item was purchased."
        }
      }
    }
  }
}
